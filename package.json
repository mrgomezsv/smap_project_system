{
  "name": "kidsfun-platform",
  "version": "2.0.0",
  "private": true,
  "description": "Kidsfun Platform - Monorepo NestJS + Next.js (migración desde Django)",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf node_modules dist .next coverage",
    "db:migrate": "pnpm --filter api prisma migrate dev",
    "db:studio": "pnpm --filter api prisma studio",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:deploy": "./build_deploy_portainer.sh",
    "deploy:portainer": "./build_deploy_portainer.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "concurrently": "^10.0.3"
  }
}
