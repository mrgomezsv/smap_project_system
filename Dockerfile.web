# ============================================
# Stage 1: deps
# ============================================
FROM node:20-alpine AS deps
RUN corepack enable
WORKDIR /repo

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/ 2>/dev/null || true

RUN pnpm install --filter web... --frozen-lockfile

# ============================================
# Stage 2: build
# ============================================
FROM node:20-alpine AS build
RUN corepack enable
WORKDIR /repo

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_URL=https://kidsfunyfiestasinfantiles.com
ENV NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA0f6Kx-Ixq77JzDAKMbxwvZFBXYaoRK4M
ENV NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=smap-kf.firebaseapp.com
ENV NEXT_PUBLIC_FIREBASE_PROJECT_ID=smap-kf
ENV NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=smap-kf.firebasestorage.app
ENV NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=270487164933
ENV NEXT_PUBLIC_FIREBASE_APP_ID=1:270487164933:web:6575488d5a733fe878a46c

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/ 2>/dev/null || true

RUN pnpm install --filter web... --frozen-lockfile

COPY apps/web ./apps/web
RUN cd apps/web && pnpm build

# ============================================
# Stage 3: runtime
# ============================================
FROM node:20-alpine AS runtime
RUN apk add --no-cache tini
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Copiar artefactos de Next.js
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./.next/static
# El standalone de Next.js sirve /public relativo a __dirname del server.js
# (apps/web/public). Hay que copiar ahí la carpeta public para que el
# servidor la encuentre; el volumen media_data se monta sobre
# apps/web/public/media para servir las imágenes de productos en /media/*.
COPY --from=build /repo/apps/web/public ./apps/web/public

EXPOSE 3000

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "server.js"]
