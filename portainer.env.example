# ==================================================================
#  VARIABLES DEL STACK KIDSFUN PARA PORTAINER
#
#  Cómo usarlo:
#   1. Copia este archivo como "portainer.env" (ese nombre NO se sube a git).
#   2. Rellena los valores siguiendo los comentarios.
#   3. En Portainer: Stacks → tu stack → Editor → "Environment variables"
#      → "Load variables from .env file" → selecciona portainer.env
#      (o crea cada variable a mano con el mismo nombre y valor).
#   4. Pulsa "Update the stack".
# ==================================================================

# ------------------------------------------------------------------
# MariaDB
# ¡IMPORTANTE! MariaDB solo usa estas contraseñas la PRIMERA vez que crea
# la base de datos. Tu volumen ya existe, así que aquí debes poner las
# contraseñas que la BD tiene HOY. Si pones otras, la API no podrá conectarse.
# Para cambiarlas de verdad, sigue "Cambiar la contraseña de la BD" abajo.
# ------------------------------------------------------------------
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ------------------------------------------------------------------
# Redis: inventa una clave larga nueva (ej. 32 caracteres al azar).
# No necesita configurarse en ningún otro lado.
# ------------------------------------------------------------------
REDIS_PASSWORD=

# ------------------------------------------------------------------
# Firebase Admin: el archivo JSON de la "service account" en base64.
# Descárgalo en Firebase Console → Configuración del proyecto →
# Cuentas de servicio → "Generar nueva clave privada".
# En PowerShell (Windows), convierte el JSON a base64 y cópialo:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\ruta\clave.json")) | Set-Clipboard
# Pega el resultado (una sola línea larga) aquí:
# ------------------------------------------------------------------
FIREBASE_CREDENTIALS_BASE64=

# ------------------------------------------------------------------
# Resend (correos de waivers, contratos y contraseñas).
# Crea una API key nueva en https://resend.com/api-keys y revoca las
# anteriores (una estaba escrita en el código del repo público).
# ------------------------------------------------------------------
RESEND_API_KEY=

# ------------------------------------------------------------------
# Opcional: si es "true", la API no arranca cuando falla una migración.
# Déjalo en false hasta revisar el estado con "npx prisma migrate status".
# ------------------------------------------------------------------
MIGRATIONS_STRICT=false

# ==================================================================
# Cambiar la contraseña de la BD (hacerlo una sola vez, con calma):
#   1. Portainer → Containers → contenedor "db" → Console → /bin/bash
#   2. mariadb -u root -p     (escribe la contraseña root ACTUAL)
#   3. ALTER USER 'mrgomez'@'%' IDENTIFIED BY 'NuevaClaveSegura';
#      ALTER USER 'root'@'%' IDENTIFIED BY 'NuevaClaveRoot';
#      ALTER USER 'root'@'localhost' IDENTIFIED BY 'NuevaClaveRoot';
#      FLUSH PRIVILEGES;
#   4. Pon las nuevas en DB_PASSWORD / DB_ROOT_PASSWORD y actualiza el stack.
# ==================================================================
