# ============================================================
# Variables para docker-compose (copiar a .env junto al compose
# o definirlas como Environment Variables del stack en Portainer)
# NUNCA commitear el archivo .env con valores reales.
# ============================================================

# --- Base de datos MariaDB ---
DB_PASSWORD=cambia-esta-clave
DB_ROOT_PASSWORD=cambia-esta-clave-root

# --- Redis ---
REDIS_PASSWORD=cambia-esta-clave-redis

# --- Firebase Admin (JSON de la service account codificado en base64) ---
# base64 -w0 credentials/smap-kf-firebase-adminsdk-xxxx.json
FIREBASE_CREDENTIALS_BASE64=

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
