# ============================================================
# Backend NestJS - Variables de entorno
# Copiar a .env y rellenar valores reales
# ============================================================

# --- Aplicación ---
NODE_ENV=development
PORT=3001

# --- Base de datos MariaDB (debe coincidir con el docker local) ---
DATABASE_URL="mysql://mrgomez:Karin2100@127.0.0.1:3307/smap_kf"

# --- Firebase Admin SDK ---
# Ruta al JSON de credenciales (NO commitear el JSON real)
FIREBASE_CREDENTIALS_PATH=credentials/smap-kf-firebase-adminsdk-xqq0l-dc3c83c990.json
FIREBASE_PROJECT_ID=smap-kf

# --- Email SMTP (Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kidsfun.developer@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=kidsfun.developer@gmail.com

# --- Email Resend ---
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="Kidsfun <waiver@kidsfunyfiestasinfantiles.com>"

# --- CORS (orígenes permitidos) ---
# En dev: Next.js en 3000, en prod: dominio real
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Logging ---
LOG_LEVEL=debug

# --- Archivos ---
UPLOAD_DIR=media
MAX_UPLOAD_SIZE_MB=10
CONTRACT_STORAGE_DIR=private/contracts

# --- Admin allowlist ---
# Emails (comma-separated) autorizados para endpoints de admin
# (validate QR, listar todos los waivers, ver scans).
# Vacío = nadie. Configurar ANTES de hacer deploy.
ADMIN_EMAILS=admin@kidsfun.com
