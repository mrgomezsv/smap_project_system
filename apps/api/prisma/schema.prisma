model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(50)
  entityId  String?  @map("entity_id") @db.VarChar(64)
  metadata  Json?
  ip        String?  @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  @@index([userId, createdAt(sort: Desc)], map: "idx_audit_user_created")
  @@index([entity, entityId], map: "idx_audit_entity")
  @@index([action, createdAt(sort: Desc)], map: "idx_audit_action_created")
  @@map("t_app_audit_log")
}

model ProductImage {
  id        BigInt  @id @default(autoincrement())
  productId BigInt  @map("product_id")
  url       String  @db.VarChar(255)
  altText   String? @map("alt_text") @db.VarChar(255)
  position  Int     @default(0)
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "t_app_product_image_product_fk")
  user    User?   @relation(fields: [userId], references: [id])
  userId  Int?

  @@index([productId, position], map: "idx_product_image_product")
  @@index([productId, isPrimary], map: "idx_product_image_primary")
  @@map("t_app_product_image")
}

model ContractSafetyItem {
  id         BigInt  @id @default(autoincrement())
  contractId Int     @map("contract_id")
  itemKey    String  @map("item_key") @db.VarChar(50)
  isChecked  Boolean @default(false) @map("is_checked")

  contract RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "t_app_contract_safety_contract_fk")

  @@unique([contractId, itemKey], map: "t_app_contract_safety_unique")
  @@index([contractId], map: "idx_safety_contract")
  @@map("t_app_contract_safety_item")
}

model Client {
  id             Int      @id @default(autoincrement())
  email          String   @unique(map: "t_app_client_email_unique") @db.VarChar(254)
  name           String   @db.VarChar(150)
  phone          String?  @db.VarChar(50)
  address        String?  @db.VarChar(255)
  cityStateZip   String?  @map("city_state_zip") @db.VarChar(150)
  driverLicense  String?  @map("driver_license") @db.VarChar(50)
  userId         Int?     @unique(map: "t_app_client_user_id_unique") @map("user_id")
  source         String   @default("manual") @db.VarChar(30)
  notes          String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "t_app_client_user_fk")
  rentalContracts RentalContract[]

  @@index([name], map: "idx_client_name")
  @@index([isActive], map: "idx_client_active")
  @@index([source], map: "idx_client_source")
  @@map("t_app_client")
}

model ContractDocument {
  id                BigInt   @id @default(autoincrement())
  contractId        Int      @map("contract_id")
  paymentId         BigInt?  @map("payment_id")
  kind              String   @db.VarChar(30)
  originalFilename  String   @map("original_filename") @db.VarChar(255)
  mimeType          String   @map("mime_type") @db.VarChar(120)
  sizeBytes         Int      @map("size_bytes")
  sha256            String   @db.VarChar(64)
  storagePath       String   @map("storage_path") @db.VarChar(500)
  uploadedById      Int?     @map("uploaded_by_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(6)

  contract   RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "t_app_contract_document_contract_fk")
  payment    ContractPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "t_app_contract_document_payment_fk")
  uploadedBy User?            @relation("ContractDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "t_app_contract_document_uploader_fk")

  @@index([contractId, kind], map: "idx_contract_document_contract_kind")
  @@index([paymentId], map: "idx_contract_document_payment")
  @@index([createdAt(sort: Desc)], map: "idx_contract_document_created")
  @@map("t_app_contract_document")
}

model ContractPayment {
  id           BigInt   @id @default(autoincrement())
  contractId   Int      @map("contract_id")
  type         String   @db.VarChar(20)
  amount       Decimal  @db.Decimal(10, 2)
  method       String   @db.VarChar(40)
  reference    String?  @db.VarChar(120)
  notes        String?  @db.Text
  paidAt       DateTime @map("paid_at") @db.DateTime(6)
  createdById  Int?     @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(6)

  contract    RentalContract    @relation(fields: [contractId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "t_app_contract_payment_contract_fk")
  createdBy   User?             @relation("ContractPaymentCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "t_app_contract_payment_creator_fk")
  documents   ContractDocument[]

  @@index([contractId], map: "idx_contract_payment_contract")
  @@index([contractId, type], map: "idx_contract_payment_contract_type")
  @@index([paidAt(sort: Desc)], map: "idx_contract_payment_paid_at")
  @@map("t_app_contract_payment")
}
