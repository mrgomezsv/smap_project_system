// This is your Prisma schema file.
// Modelos equivalentes a los Django models de t_app_product/models.py

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// FASE 4 - Modelos de t_app_product
// ============================================================
// Commit #26: Product + Event

model User {
  id          Int       @id @default(autoincrement())
  password    String    @default("!") @db.VarChar(255)
  lastLogin   DateTime? @map("last_login") @db.DateTime(6)
  isSuperuser Boolean   @default(false) @map("is_superuser")
  username    String    @unique @db.VarChar(150)
  firstName   String    @default("") @map("first_name") @db.VarChar(150)
  lastName    String    @default("") @map("last_name") @db.VarChar(150)
  email       String    @unique @default("") @db.VarChar(254)
  isStaff     Boolean   @default(false) @map("is_staff")
  isActive    Boolean   @default(true) @map("is_active")
  dateJoined  DateTime  @default(now()) @map("date_joined") @db.DateTime(6)

  productsCreated   Product[]           @relation("ProductCreatedBy")
  eventsOrganized   Event[]             @relation("EventOrganizer")
  productLikes      ProductLike[]
  productImages     ProductImage[]
  commentsLinked    ProductComment[]    @relation("CommentUserInt")
  repliesLinked     CommentReply[]      @relation("ReplyUserInt")
  chatAdminRoles    ChatAdministrator[]
  chatRooms         ChatRoom[]
  sentMessages      ChatMessage[]
  waiversLinked     WaiverQRV2[]        @relation("WaiverUserInt")
  waiverValidations WaiverValidator[]
  firebaseUser      FirebaseUser?
  clientProfile     Client?
  contractsCreated  RentalContract[]    @relation("ContractCreatedBy")
  uploadedContractDocuments ContractDocument[] @relation("ContractDocumentUploader")
  contractPaymentsCreated ContractPayment[]    @relation("ContractPaymentCreator")

  @@index([dateJoined], map: "idx_user_datejoined")
  @@index([isActive], map: "idx_user_active")
  @@map("auth_user")
}

model Product {
  id          BigInt   @id @default(autoincrement())
  title       String   @db.VarChar(100)
  description String?  @db.LongText
  price       Decimal? @db.Decimal(10, 2)
  category    String   @db.VarChar(50)
  created     DateTime @default(now()) @db.DateTime(0)
  publicated  Boolean  @default(false)
  userId      Int      @map("user_id")
  // 6 imágenes legacy: principal + 5 adicionales (mantener durante migración gradual)
  img         String   @default("default_product_image.jpg") @db.VarChar(100)
  img1        String   @default("default_product_image.jpg") @db.VarChar(100)
  img2        String   @default("default_product_image.jpg") @db.VarChar(100)
  img3        String   @default("default_product_image.jpg") @db.VarChar(100)
  img4        String   @default("default_product_image.jpg") @db.VarChar(100)
  img5        String   @default("default_product_image.jpg") @db.VarChar(100)
  dimensions  String?  @db.VarChar(50)
  youtubeUrl  String?  @map("youtube_url") @db.VarChar(255)
  circuits    String?  @db.VarChar(50)
  space       String?  @db.VarChar(50)

  user User @relation("ProductCreatedBy", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "t_app_product_product_user_id_b85feb0c_fk_auth_user_id")

  images   ProductImage[]
  likes    ProductLike[]
  comments ProductComment[]

  @@index([category], map: "idx_product_category")
  @@index([publicated], map: "idx_product_publicated")
  @@index([title], map: "idx_product_title")
  @@index([userId], map: "idx_product_user_id")
  @@index([category, publicated, created(sort: Desc)], map: "idx_product_cat_pub_created")
  @@index([publicated, created(sort: Desc)], map: "idx_product_pub_created")
  @@map("t_app_product_product")
}

model Event {
  id            BigInt   @id @default(autoincrement())
  title         String   @db.VarChar(200)
  description   String   @db.LongText
  location      String   @db.VarChar(200)
  startDatetime DateTime @map("start_datetime") @db.DateTime(0)
  ticketPrice   Decimal  @default(0.00) @map("ticket_price") @db.Decimal(10, 2)
  published     Boolean
  organizerId   Int      @map("organizer_id")
  partners      String   @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(6)
  image         String?  @db.VarChar(100)
  slug          String?  @unique(map: "slug") @db.VarChar(250)

  organizer User @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "t_app_event_organizer_id_e88c3f24_fk_auth_user_id")

  @@index([organizerId], map: "t_app_event_organizer_id_e88c3f24")
  @@index([published, startDatetime], map: "idx_event_pub_start")
  @@index([startDatetime], map: "idx_event_start")
  @@index([partners], map: "idx_event_partners")
  @@map("t_app_event")
}

// ============================================================
// Commit #27: ProductLike + ProductComment + CommentReply
// ============================================================

model ProductLike {
  id         BigInt   @id @default(autoincrement())
  productId  BigInt   @map("product_id")
  userId     Int      @map("user_id")
  isFavorite Boolean  @default(false) @map("is_favorite")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "t_app_product_like_product_id_fk")
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "t_app_product_like_user_id_fk")

  @@unique([userId, productId], map: "t_app_product_like_user_id_product_id_unique")
  @@index([productId], map: "idx_productlike_product")
  @@index([productId, isFavorite], map: "idx_productlike_product_fav")
  @@index([createdAt], map: "idx_productlike_created")
  @@map("t_app_product_like")
}

model ProductComment {
  id              BigInt   @id @default(autoincrement())
  productId       BigInt   @map("product_id")
  userId          String?  @map("user_id") @db.VarChar(128)
  userIdInt       Int?     @map("user_id_int")
  userDisplayName String?  @map("user_display_name") @db.VarChar(255)
  comment         String   @db.LongText
  isApproved      Boolean  @default(true) @map("is_approved")
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(6)

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "t_app_product_comment_product_id_fk")
  replies CommentReply[]
  userInt User?          @relation("CommentUserInt", fields: [userIdInt], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "t_app_product_comment_user_id_int_fk")

  @@index([userIdInt], map: "idx_comment_user_id_int")
  @@index([productId], map: "idx_productcomment_product")
  @@index([productId, isApproved, createdAt(sort: Desc)], map: "idx_comment_product_appr_created")
  @@index([createdAt(sort: Desc)], map: "idx_comment_created")
  @@index([isApproved], map: "idx_comment_is_approved")
  @@map("t_app_product_comment")
}

model CommentReply {
  id              BigInt   @id @default(autoincrement())
  commentId       BigInt   @map("comment_id")
  userId          String?  @map("user_id") @db.VarChar(128)
  userIdInt       Int?     @map("user_id_int")
  userDisplayName String?  @map("user_display_name") @db.VarChar(255)
  replyText       String   @map("reply_LONGTEXT") @db.LongText
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(6)

  comment ProductComment @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "t_app_product_comment_reply_comment_id_fk")
  userInt User?          @relation("ReplyUserInt", fields: [userIdInt], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "t_app_product_comment_reply_user_id_int_fk")

  @@index([commentId], map: "idx_commentreply_comment")
  @@index([commentId, createdAt], map: "idx_reply_comment_created")
  @@index([userIdInt], map: "idx_reply_user_id_int")
  @@map("t_app_product_comment_reply")
}

// ============================================================
// Commit #28: Waiver V2 - Sistema QR
// Equivalente a waiver_v2/models.py de Django
// ============================================================

model WaiverQRV2 {
  id        BigInt   @id @default(autoincrement())
  qrCode    String   @unique @map("qr_code") @db.VarChar(8)
  userId    String   @map("user_id") @db.VarChar(100)
  userIdInt Int?     @map("user_id_int")
  userName  String   @map("user_name") @db.VarChar(100)
  userEmail String   @map("user_email") @db.VarChar(255)
  userPhone String?  @map("user_phone") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  expiresAt DateTime @map("expires_at") @db.DateTime(0)
  status    String   @default("ACTIVE") @db.VarChar(10)

  relatives WaiverDataV2[]
  scans     WaiverScanV2[]
  userInt   User?          @relation("WaiverUserInt", fields: [userIdInt], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "waiver_v2_waiverqr_user_id_int_fk")

  @@index([userId], map: "idx_waiver_user")
  @@index([userIdInt], map: "idx_waiver_user_id_int")
  @@index([status, createdAt(sort: Desc)], map: "idx_waiver_status_created")
  @@index([createdAt(sort: Desc)], map: "idx_waiver_created")
  @@index([expiresAt], map: "idx_waiver_expires")
  @@map("waiver_v2_waiverqr")
}

model WaiverDataV2 {
  id           BigInt   @id @default(autoincrement())
  waiverQrId   BigInt   @map("waiver_qr_id")
  relativeName String   @map("relative_name") @db.VarChar(100)
  relativeAge  Int      @map("relative_age")
  timestamp    DateTime @default(now()) @db.DateTime(6)

  waiverQr WaiverQRV2 @relation(fields: [waiverQrId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "waiver_v2_waiverdata_qr_fk")

  @@index([waiverQrId], map: "waiver_v2_waiverdata_waiver_qr_id_fk")
  @@index([timestamp(sort: Desc)], map: "idx_waiverdata_timestamp")
  @@map("waiver_v2_waiverdata")
}

model WaiverScanV2 {
  id         BigInt   @id @default(autoincrement())
  waiverQrId BigInt   @map("waiver_qr_id")
  scannedBy  String   @map("scanned_by") @db.VarChar(100)
  scannedAt  DateTime @default(now()) @map("scanned_at") @db.DateTime(6)

  waiverQr WaiverQRV2 @relation(fields: [waiverQrId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "waiver_v2_waiverscan_qr_fk")

  @@index([waiverQrId], map: "waiver_v2_waiverscan_waiver_qr_id_fk")
  @@index([scannedBy, scannedAt(sort: Desc)], map: "idx_scan_by_when")
  @@index([scannedAt(sort: Desc)], map: "idx_scan_when")
  @@map("waiver_v2_waiverscan")
}

model WaiverDocument {
  id        Int      @id @default(autoincrement())
  title     String   @default("Documento de Exención de Responsabilidad (Waiver)") @db.VarChar(200)
  content   String   @db.LongText
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  @@map("waiver_v2_waiverdocument")
}

