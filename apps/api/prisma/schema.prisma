// ============================================================
// Módulo de Contratos Digitales de Alquiler (RentalContract)
// ============================================================

model RentalContract {
  id                 Int       @id @default(autoincrement())
  token              String    @unique @db.VarChar(64)
  clientName         String    @map("client_name") @db.VarChar(150)
  clientEmail        String    @map("client_email") @db.VarChar(254)
  clientPhone        String?   @map("client_phone") @db.VarChar(50)
  clientAddress      String    @map("client_address") @db.VarChar(255)
  clientCityStateZip String?   @map("client_city_state_zip") @db.VarChar(150)
  driverLicense      String?   @map("driver_license") @db.VarChar(50)
  eventDate          DateTime? @map("event_date") @db.Date
  startTime          String?   @map("start_time") @db.VarChar(50)
  endTime            String?   @map("end_time") @db.VarChar(50)
  equipment          String    @db.VarChar(255)
  groundType         String?   @map("ground_type") @db.VarChar(50)
  price              Decimal?  @db.Decimal(10, 2)
  deposit            Decimal?  @db.Decimal(10, 2)
  notes              String?   @db.Text
  status             String    @default("PENDING") @db.VarChar(20) // PENDING, SIGNED, EXPIRED, CANCELLED
  safetyChecklist    Json?     @map("safety_checklist")
  signatureImage     String?   @map("signature_image") @db.LongText
  signedAt           DateTime? @map("signed_at") @db.DateTime(6)
  signerIp           String?   @map("signer_ip") @db.VarChar(45)
  signerUserAgent    String?   @map("signer_user_agent") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(6)
  expiresAt          DateTime? @map("expires_at") @db.DateTime(6)
  viewedAt           DateTime? @map("viewed_at") @db.DateTime(6)
  archivedAt         DateTime? @map("archived_at") @db.DateTime(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.DateTime(6)
  cancelReason       String?   @map("cancel_reason") @db.Text
  signatureMethod    String?   @map("signature_method") @db.VarChar(30)
  createdById        Int?      @map("created_by_id")
  clientId           Int?      @map("client_id")

  createdBy     User?               @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "t_app_rental_contract_created_by_fk")
  client        Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "t_app_rental_contract_client_fk")
  safetyItems   ContractSafetyItem[]
  documents     ContractDocument[]
  payments      ContractPayment[]

  @@index([token], map: "idx_rental_contract_token")
  @@index([clientEmail], map: "idx_rental_contract_email")
  @@index([status, createdAt(sort: Desc)], map: "idx_contract_status_created")
  @@index([eventDate], map: "idx_contract_eventdate")
  @@index([clientName], map: "idx_contract_client_name")
  @@index([clientId], map: "idx_rental_contract_client_id")
  @@index([createdById], map: "idx_rental_contract_created_by")
  @@index([expiresAt], map: "idx_rental_contract_expires_at")
  @@index([archivedAt], map: "idx_rental_contract_archived_at")
  @@map("t_app_rental_contract")
}

