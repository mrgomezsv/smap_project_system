model ChatAdministrator {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  email     String   @unique @db.VarChar(254)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "t_app_chat_administrator_user_id_fk")

  @@index([userId], map: "t_app_chat_administrator_user_id_fk")
  @@map("t_app_chat_administrator")
}

model ChatRoom {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(6)
  isActive      Boolean  @default(true) @map("is_active")
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.DateTime(6)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "t_app_chat_room_user_id_fk")
